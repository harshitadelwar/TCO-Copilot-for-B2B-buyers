# Copy to .env or export in your shell. NEVER commit a real key.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional
# TCO_MODEL=claude-sonnet-5-5      # default; try claude-haiku-5-5 for cheaper extraction
